# Copy to .env before running Docker Compose. Replace every CHANGE_ME value.
NODE_ENV=production
APP_ENV=production
API_PORT=8080
FRONTEND_PORT=3000
POSTGRES_DB=kiiro_host
POSTGRES_USER=kiiro
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password
DATABASE_URL=postgresql://kiiro:CHANGE_ME_generate_a_long_random_password@postgres:5432/kiiro_host?schema=public
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_generate_another_long_random_password
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Frontend server-side requests use the Docker service name. Browser requests use same-origin proxy path.
API_BASE_URL=http://api:8080/api
NEXT_PUBLIC_API_BASE_URL=/api/backend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_MOCK_MODE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
AUTH_SESSION_SECRET=CHANGE_ME_at_least_32_random_bytes
SESSION_TTL_HOURS=24
LOG_LEVEL=info
