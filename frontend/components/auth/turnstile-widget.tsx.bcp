"use client";

import Script from "next/script";
import { useEffect, useId, useRef, useState } from "react";
import type { Dictionary } from "@/lib/i18n/types";

interface TurnstileWidgetProps {
  value: string;
  onChange: (value: string) => void;
  dictionary: Dictionary;
}

declare global {
  interface Window {
    turnstile?: {
      render: (
        container: string | HTMLElement,
        options: {
          sitekey: string;
          callback?: (token: string) => void;
          "expired-callback"?: () => void;
          "error-callback"?: () => void;
        },
      ) => string;
      reset: (widgetId?: string) => void;
      remove: (widgetId?: string) => void;
    };
  }
}

type WidgetState = "loading" | "ready" | "tokenReceived" | "expired" | "error";

function TurnstileWidget({ value, onChange, dictionary }: TurnstileWidgetProps) {
  const siteKey = process.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY;
  const [state, setState] = useState<WidgetState>(siteKey ? "loading" : "error");
  const [scriptLoaded, setScriptLoaded] = useState(false);
  const widgetIdRef = useRef<string | null>(null);
  const onChangeRef = useRef(onChange);
  const renderedRef = useRef(false);
  const containerId = useId().replace(/:/g, "");

  useEffect(() => {
    onChangeRef.current = onChange;
  }, [onChange]);

  useEffect(() => {
    if (!siteKey || !scriptLoaded || !window.turnstile || renderedRef.current) {
      return;
    }

    widgetIdRef.current = window.turnstile.render(`#${containerId}`, {
      sitekey: siteKey,
      callback: (token: string) => {
        onChangeRef.current(token);
        setState("tokenReceived");
      },
      "expired-callback": () => {
        onChangeRef.current("");
        setState("expired");
      },
      "error-callback": () => {
        onChangeRef.current("");
        setState("error");
      },
    });
    renderedRef.current = true;
    setState("ready");

    return () => {
      if (window.turnstile && widgetIdRef.current) {
        window.turnstile.remove(widgetIdRef.current);
        widgetIdRef.current = null;
        renderedRef.current = false;
      }
    };
  }, [containerId, scriptLoaded, siteKey]);

  const statusText: Record<WidgetState, string> = {
    loading: dictionary.auth.turnstileWidgetStatusLoading,
    ready: dictionary.auth.turnstileWidgetStatusReady,
    tokenReceived: dictionary.auth.turnstileWidgetStatusTokenReceived,
    expired: dictionary.auth.turnstileWidgetStatusExpired,
    error: dictionary.auth.turnstileWidgetStatusError,
  };

  return (
    <div className="rounded-lg border border-slate-200 bg-slate-50 p-3">
      <p className="text-sm font-medium text-slate-800">{dictionary.auth.turnstileWidgetTitle}</p>
      <p className="mt-1 text-xs text-slate-600">{dictionary.auth.turnstileWidgetDescription}</p>
      <p className="mt-2 text-xs text-slate-500">
        {dictionary.auth.turnstileWidgetSiteKeyLabel}: {siteKey ? "configured" : "missing NEXT_PUBLIC_TURNSTILE_SITE_KEY"}
      </p>
      <p className="mt-1 text-xs text-slate-500">
        {dictionary.auth.turnstileWidgetStatusLabel}: {statusText[state]}
      </p>
      {siteKey ? (
        <Script
          id="cloudflare-turnstile"
          src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
          strategy="afterInteractive"
          onLoad={() => {
            setScriptLoaded(true);
          }}
          onError={() => {
            setScriptLoaded(false);
            setState("error");
          }}
        />
      ) : null}
      <div
        className="mt-3 min-h-[65px] rounded-md border border-slate-200 bg-white p-2"
        role="group"
        aria-label={dictionary.auth.turnstileWidgetTitle}
      >
        <div id={containerId} />
      </div>
      <div className="mt-3">
        <button
          type="button"
          className="rounded-md border border-slate-300 px-3 py-2 text-xs font-medium"
          onClick={() => {
            if (window.turnstile && widgetIdRef.current) {
              window.turnstile.reset(widgetIdRef.current);
            }
            onChangeRef.current("");
            setState("loading");
          }}
        >
          {dictionary.auth.turnstileWidgetResetAction}
        </button>
      </div>
      <input
        className="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-xs"
        readOnly
        value={value}
        placeholder="turnstileToken"
      />
    </div>
  );
}

export { TurnstileWidget };
export default TurnstileWidget;
