{
  "name": "kiiro-host",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24.11.0 <25", "npm": ">=11" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run start:dev -w @kiiro/api",
    "dev:worker": "npm run start:dev -w @kiiro/worker",
    "build": "npm run build -w @kiiro/api && npm run build -w @kiiro/worker",
    "lint": "npm run lint -w @kiiro/api && npm run lint -w @kiiro/worker",
    "db:generate": "npm run db:generate -w @kiiro/database",
    "db:migrate:dev": "npm run db:migrate:dev -w @kiiro/database",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @kiiro/database",
    "db:studio": "npm run db:studio -w @kiiro/database",
    "db:seed": "npm run db:seed -w @kiiro/database"
  },
  "devDependencies": { "typescript": "~5.9.3", "@types/node": "^24.10.0" }
}
