generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}
enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}
enum ProviderSlug {
  INCUS
  PROXMOX
}
enum ProviderStatus {
  ACTIVE
  PLANNED
  MAINTENANCE
  DISABLED
}
enum NodeStatus {
  ONLINE
  DEGRADED
  MAINTENANCE
  OFFLINE
}
enum InstanceKind {
  VM
  CONTAINER
}
enum InstanceStatus {
  PENDING
  PROVISIONING
  RUNNING
  STOPPED
  ERROR
  DELETING
  DELETED
}
enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}
enum TaskType {
  PROVISION
  START
  STOP
  REBOOT
  REINSTALL
  RESIZE
  SNAPSHOT
  BACKUP
  DELETE
  RECONCILE
}
enum BillingModel {
  PREPAID
  SUBSCRIPTION
}
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}
enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}
enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
enum AddressFamily {
  IPV4
  IPV6
}
enum IpStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  BLOCKED
}
enum BackupStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique @db.VarChar(320)
  passwordHash       String       @map("password_hash") @db.VarChar(255)
  role               UserRole     @default(USER)
  status             UserStatus   @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer           Customer?
  sessions           Session[]
  totp               UserTotp?
  tokens             AuthToken[]
  auditLogs          AuditLog[]
  @@map("users")
}

model Customer {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  displayName String?  @map("display_name") @db.VarChar(160)
  companyName String?  @map("company_name") @db.VarChar(200)
  countryCode String?  @map("country_code") @db.Char(2)
  timezone    String   @default("UTC") @db.VarChar(64)
  phone       String?  @db.VarChar(40)
  billingEmail String? @map("billing_email") @db.VarChar(320)
  addressLine1 String? @map("address_line_1") @db.VarChar(200)
  addressLine2 String? @map("address_line_2") @db.VarChar(200)
  city        String?  @db.VarChar(120)
  state       String?  @db.VarChar(120)
  postalCode  String?  @map("postal_code") @db.VarChar(32)
  taxId       String?  @map("tax_id") @db.VarChar(80)
  adminNotes  String?  @map("admin_notes") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances   Instance[]
  orders      Order[]
  wallet      Wallet?
  invoices    Invoice[]
  subscriptions Subscription[]
  tickets     SupportTicket[]
  @@map("customers")
}

model Session {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  tokenHash   String   @unique @map("token_hash") @db.VarChar(128)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model UserTotp {
  userId            String    @id @map("user_id")
  encryptedSecret   Bytes     @map("encrypted_secret")
  keyVersion        Int       @default(1) @map("key_version")
  enabledAt         DateTime? @map("enabled_at") @db.Timestamptz(6)
  lastUsedStep      BigInt?   @map("last_used_step")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_totp")
}

model AuthToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  type       TokenType
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
  @@map("auth_tokens")
}

model Provider {
  id          String         @id @default(cuid())
  slug        ProviderSlug   @unique
  name        String         @db.VarChar(120)
  description String?        @db.Text
  status      ProviderStatus @default(PLANNED)
  config      Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  credentials ProviderCredential[]
  nodes       Node[]
  images      OsImage[]
  instances   Instance[]
  @@map("providers")
}

model ProviderCredential {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  name            String   @db.VarChar(120)
  encryptedSecret Bytes    @map("encrypted_secret")
  keyVersion      Int      @default(1) @map("key_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@index([providerId])
  @@map("provider_credentials")
}

model Region {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(16)
  name      String   @db.VarChar(120)
  country   String   @db.Char(2)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  nodes     Node[]
  plans     PlanRegion[]
  instances Instance[]
  @@map("regions")
}

model Node {
  id             String     @id @default(cuid())
  providerId     String     @map("provider_id")
  regionId       String     @map("region_id")
  name           String     @db.VarChar(120)
  externalId     String?    @map("external_id") @db.VarChar(255)
  status         NodeStatus @default(OFFLINE)
  totalVcpu      Int        @default(0) @map("total_vcpu")
  reservedVcpu   Int        @default(0) @map("reserved_vcpu")
  totalMemoryMb  BigInt     @default(0) @map("total_memory_mb")
  reservedMemoryMb BigInt   @default(0) @map("reserved_memory_mb")
  totalDiskGb    BigInt     @default(0) @map("total_disk_gb")
  reservedDiskGb BigInt     @default(0) @map("reserved_disk_gb")
  metadata       Json       @default("{}")
  lastSeenAt     DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider       Provider   @relation(fields: [providerId], references: [id])
  region         Region     @relation(fields: [regionId], references: [id])
  instances      Instance[]
  @@unique([providerId, name])
  @@index([regionId, status])
  @@map("nodes")
}

model OsImage {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  slug        String   @db.VarChar(100)
  name        String   @db.VarChar(160)
  version     String   @db.VarChar(80)
  osFamily    String   @map("os_family") @db.VarChar(60)
  kindSupport InstanceKind[] @map("kind_support")
  enabled     Boolean  @default(true)
  metadata    Json     @default("{}")
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  instances   Instance[]
  @@unique([providerId, slug])
  @@map("os_images")
}

model Plan {
  id          String      @id @default(cuid())
  slug        String      @unique @db.VarChar(100)
  name        String      @db.VarChar(160)
  description String?     @db.Text
  vcpu        Int
  memoryMb    Int         @map("memory_mb")
  diskGb      Int         @map("disk_gb")
  kindSupport InstanceKind[] @map("kind_support")
  enabled     Boolean     @default(true)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  prices      PlanPrice[]
  regions     PlanRegion[]
  instances   Instance[]
  orderItems  OrderItem[]
  @@map("plans")
}

model PlanPrice {
  id          String       @id @default(cuid())
  planId      String       @map("plan_id")
  billingModel BillingModel @map("billing_model")
  currency    String       @db.Char(3)
  amountMinor BigInt       @map("amount_minor")
  interval    String?      @db.VarChar(16)
  active      Boolean      @default(true)
  validFrom   DateTime     @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime?    @map("valid_until") @db.Timestamptz(6)
  plan        Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@index([planId, billingModel, currency, active])
  @@map("plan_prices")
}

model PlanRegion {
  planId   String @map("plan_id")
  regionId String @map("region_id")
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  @@id([planId, regionId])
  @@map("plan_regions")
}

model Instance {
  id                String         @id @default(cuid())
  customerId        String         @map("customer_id")
  providerId        String         @map("provider_id")
  nodeId            String         @map("node_id")
  regionId          String         @map("region_id")
  imageId           String         @map("image_id")
  planId            String         @map("plan_id")
  name              String         @db.VarChar(120)
  externalId        String?        @map("external_id") @db.VarChar(255)
  kind              InstanceKind
  status            InstanceStatus @default(PENDING)
  desiredState      String         @default("RUNNING") @map("desired_state") @db.VarChar(24)
  observedState     String         @default("UNKNOWN") @map("observed_state") @db.VarChar(24)
  vcpu              Int
  memoryMb          Int            @map("memory_mb")
  diskGb            Int            @map("disk_gb")
  metadata          Json           @default("{}")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  customer          Customer       @relation(fields: [customerId], references: [id])
  provider          Provider       @relation(fields: [providerId], references: [id])
  node              Node           @relation(fields: [nodeId], references: [id])
  region            Region         @relation(fields: [regionId], references: [id])
  image             OsImage        @relation(fields: [imageId], references: [id])
  plan              Plan           @relation(fields: [planId], references: [id])
  addresses         InstanceAddress[]
  tasks             Task[]
  snapshots         Snapshot[]
  backups           Backup[]
  events            InstanceEvent[]
  @@index([customerId, status])
  @@index([nodeId, status])
  @@map("instances")
}

model InstanceAddress {
  id         String        @id @default(cuid())
  instanceId String        @map("instance_id")
  family     AddressFamily
  address    String        @db.VarChar(64)
  isPrimary  Boolean       @default(false) @map("is_primary")
  instance   Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  @@unique([family, address])
  @@index([instanceId])
  @@map("instance_addresses")
}

model InstanceEvent {
  id         String   @id @default(cuid())
  instanceId String   @map("instance_id")
  eventType  String   @map("event_type") @db.VarChar(80)
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  @@index([instanceId, createdAt])
  @@map("instance_events")
}

model Snapshot {
  id          String   @id @default(cuid())
  instanceId  String   @map("instance_id")
  name        String   @db.VarChar(120)
  externalId  String?  @map("external_id") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  instance    Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  @@index([instanceId])
  @@map("snapshots")
}

model Backup {
  id          String       @id @default(cuid())
  instanceId  String       @map("instance_id")
  status      BackupStatus @default(QUEUED)
  storageRef  String?      @map("storage_ref") @db.VarChar(512)
  sizeBytes   BigInt?      @map("size_bytes")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)
  instance    Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  @@index([instanceId, status])
  @@map("backups")
}

model Order {
  id          String      @id @default(cuid())
  customerId  String      @map("customer_id")
  status      OrderStatus @default(PENDING)
  currency    String      @db.Char(3)
  totalMinor  BigInt      @map("total_minor")
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(128)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String @map("order_id")
  planId      String @map("plan_id")
  quantity    Int    @default(1)
  unitMinor   BigInt @map("unit_minor")
  totalMinor  BigInt @map("total_minor")
  description String @db.VarChar(255)
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  plan        Plan   @relation(fields: [planId], references: [id])
  @@map("order_items")
}

model Wallet {
  id         String   @id @default(cuid())
  customerId String   @unique @map("customer_id")
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  @@map("wallets")
}

model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique @db.VarChar(80)
  name      String            @db.VarChar(160)
  type      LedgerAccountType
  currency  String            @db.Char(3)
  entries   LedgerEntry[]
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String        @id @default(cuid())
  referenceType  String?       @map("reference_type") @db.VarChar(80)
  referenceId    String?       @map("reference_id") @db.VarChar(128)
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(128)
  description    String        @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  entries        LedgerEntry[]
  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String           @id @default(cuid())
  transactionId String           @map("transaction_id")
  accountId     String           @map("account_id")
  walletId      String?          @map("wallet_id")
  amountMinor   BigInt           @map("amount_minor")
  currency      String           @db.Char(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  wallet        Wallet?          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  @@index([walletId, createdAt])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

model Invoice {
  id          String        @id @default(cuid())
  customerId  String        @map("customer_id")
  number      String        @unique @db.VarChar(40)
  status      InvoiceStatus @default(DRAFT)
  currency    String        @db.Char(3)
  subtotalMinor BigInt      @map("subtotal_minor")
  taxMinor    BigInt        @default(0) @map("tax_minor")
  totalMinor  BigInt        @map("total_minor")
  dueAt       DateTime?     @map("due_at") @db.Timestamptz(6)
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  @@index([customerId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  description String  @db.VarChar(255)
  quantity    Int     @default(1)
  unitMinor   BigInt  @map("unit_minor")
  totalMinor  BigInt  @map("total_minor")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@map("invoice_items")
}

model Subscription {
  id          String             @id @default(cuid())
  customerId  String             @map("customer_id")
  status      SubscriptionStatus @default(PENDING)
  currency    String             @db.Char(3)
  amountMinor BigInt             @map("amount_minor")
  interval    String             @db.VarChar(16)
  currentPeriodStart DateTime     @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime     @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd Boolean       @default(false) @map("cancel_at_period_end")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer             @relation(fields: [customerId], references: [id])
  @@index([customerId, status])
  @@map("subscriptions")
}

model Payment {
  id              String        @id @default(cuid())
  provider        String        @db.VarChar(80)
  providerPaymentId String?     @map("provider_payment_id") @db.VarChar(255)
  status          PaymentStatus @default(PENDING)
  currency        String        @db.Char(3)
  amountMinor     BigInt        @map("amount_minor")
  idempotencyKey  String?       @unique @map("idempotency_key") @db.VarChar(128)
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([provider, providerPaymentId])
  @@map("payments")
}

model IpPool {
  id        String       @id @default(cuid())
  regionId  String       @map("region_id")
  cidr      String       @db.VarChar(64)
  family    AddressFamily
  gateway   String?      @db.VarChar(64)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  addresses IpAddress[]
  @@unique([regionId, cidr])
  @@map("ip_pools")
}

model IpAddress {
  id         String   @id @default(cuid())
  poolId     String   @map("pool_id")
  address    String   @unique @db.VarChar(64)
  status     IpStatus @default(AVAILABLE)
  instanceId String?  @map("instance_id")
  pool       IpPool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  @@index([poolId, status])
  @@map("ip_addresses")
}

model Task {
  id           String     @id @default(cuid())
  type         TaskType
  status       TaskStatus @default(QUEUED)
  instanceId   String?    @map("instance_id")
  payload      Json       @default("{}")
  attempts     Int        @default(0)
  maxAttempts  Int        @default(5) @map("max_attempts")
  availableAt  DateTime   @default(now()) @map("available_at") @db.Timestamptz(6)
  startedAt    DateTime?  @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?  @map("finished_at") @db.Timestamptz(6)
  lastError    String?    @map("last_error") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  instance     Instance?  @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  @@index([status, availableAt])
  @@index([instanceId, createdAt])
  @@map("tasks")
}

model OutboxEvent {
  id          String   @id @default(cuid())
  eventType   String   @map("event_type") @db.VarChar(120)
  aggregateId String   @map("aggregate_id") @db.VarChar(128)
  payload     Json
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model SupportTicket {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  subject    String   @db.VarChar(200)
  status     String   @default("OPEN") @db.VarChar(32)
  priority   String   @default("NORMAL") @db.VarChar(24)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer   Customer @relation(fields: [customerId], references: [id])
  messages   SupportMessage[]
  @@index([customerId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  authorId  String        @map("author_id")
  body      String        @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(120)
  entityType String?  @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(128)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("system_settings")
}
